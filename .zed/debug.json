  {
    "label": "Python: Attach",
    "adapter": "Debugpy",
    "request": "attach",
    "python": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",
    "connect": {
      "host": "localhost",
      "port": 3000
    },
    "pathMappings": [
