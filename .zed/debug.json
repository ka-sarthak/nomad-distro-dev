[
  {
    "label": "gui",
    "adapter": "JavaScript",
    "type": "chrome",
    "request": "launch",
    "url": "http://localhost:3000",
    "webRoot": "$ZED_WORKTREE_ROOT/packages/nomad-FAIR/gui"
  },
  {
    "label": "app",
    "adapter": "Debugpy",
    "request": "launch",
    "python": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",
    "justMyCode": false,
    "program": "$ZED_WORKTREE_ROOT/.venv/bin/nomad",
    "args": ["admin", "run", "app"]
  },
  {
    "label": "test entry api",
    "adapter": "Debugpy",
    "request": "launch",
